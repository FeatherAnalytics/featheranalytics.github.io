---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}

const { title, subtitle, description } = Astro.props;
---
<Base title={title} description={description}>
  <div class="flex flex-col min-h-screen">
    <Nav />
    <main class="flex-1 max-w-3xl mx-auto w-full px-4 sm:px-6 py-12">
      <header class="mb-8">
        <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-ink">{title}</h1>
        {subtitle && <p class="mt-2 text-lg text-ink-muted">{subtitle}</p>}
      </header>
      <div class="prose max-w-none">
        <slot />
      </div>
    </main>
    <Footer />
  </div>
</Base>
