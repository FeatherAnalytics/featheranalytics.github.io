---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  subtitle?: string;
  pubDate: Date;
  tags?: string[];
  description?: string;
}

const { title, subtitle, pubDate, tags = [], description } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base title={title} description={description}>
  <div class="flex flex-col min-h-screen">
    <Nav />
    {/*
      Wider than the other layouts on purpose. The article's own text stays at a
      readable measure — `prose` caps it at 65ch below — and the extra width
      exists for the figures, which break out of that measure to the full
      container. A post with no figures reads identically to one at `max-w-3xl`.
    */}
    <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 py-12">
      <header class="mb-8 pb-6 border-b border-rule mx-auto max-w-[65ch] w-full">
        <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-ink">{title}</h1>
        {subtitle && <p class="mt-2 text-lg text-ink-muted">{subtitle}</p>}
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <time class="eyebrow text-ink-muted" datetime={pubDate.toISOString()}>{formattedDate}</time>
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {tags.map(tag => (
                <span class="eyebrow px-2 py-0.5 rounded-full border border-rule bg-paper text-ink-muted">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>
      <div class="prose mx-auto prose-img:rounded-lg">
        <slot />
      </div>
    </main>
    <Footer />
  </div>
</Base>
