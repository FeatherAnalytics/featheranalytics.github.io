---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  subtitle?: string;
  pubDate: Date;
  tags?: string[];
  description?: string;
}

const { title, subtitle, pubDate, tags = [], description } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base title={title} description={description}>
  <div class="flex flex-col min-h-screen">
    <Nav />
    <main class="flex-1 max-w-3xl mx-auto w-full px-4 sm:px-6 py-12">
      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold text-navy dark:text-dark-text">{title}</h1>
        {subtitle && <p class="mt-2 text-lg text-text-secondary dark:text-dark-secondary">{subtitle}</p>}
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-text-secondary dark:text-dark-secondary">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {tags.length > 0 && (
            <div class="flex gap-2">
              {tags.map(tag => (
                <span class="px-2 py-0.5 rounded-full bg-surface dark:bg-dark-code-bg text-xs font-medium">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>
      <div class="prose prose-slate dark:prose-invert max-w-none
        prose-headings:text-navy dark:prose-headings:text-dark-text
        prose-a:text-link dark:prose-a:text-dark-link
        prose-img:rounded-lg
        prose-code:bg-code-bg dark:prose-code:bg-dark-code-bg prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
        prose-pre:bg-code-bg dark:prose-pre:bg-dark-code-bg">
        <slot />
      </div>
    </main>
    <Footer />
  </div>
</Base>
