---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import RatingsConstellation from '../components/RatingsConstellation.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { zoneHistory, zoneHistoryImage, cinemetrics, projects } from '../data/featured';
---
<Base title="Home" description="Personal site of David Hardage — data pipelines and visualizations.">
  <div class="flex flex-col min-h-screen">
    <Nav />
    <main class="flex-1">
      <Hero />

      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20 grid grid-cols-1 lg:grid-cols-[60%_1fr] gap-8 lg:gap-12 items-center">
        <Image
          src={zoneHistoryImage}
          alt="Zone History map showing faction control across the world"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 60vw, 100vw"
          format="webp"
          class="w-full rounded-lg border border-rule"
        />
        <div>
          <p class="eyebrow text-accent">{zoneHistory.eyebrow}</p>
          <h2 class="display text-ink mt-3 text-3xl sm:text-4xl">{zoneHistory.title}</h2>
          <p class="mt-5 text-ink-body">{zoneHistory.description}</p>
          <ul class="mt-5 space-y-1.5 text-sm text-ink-body">
            {zoneHistory.proofPoints.map(point => (
              <li class="flex gap-2.5"><span class="text-accent shrink-0" aria-hidden="true">&mdash;</span><span>{point}</span></li>
            ))}
          </ul>
          <p class="mt-5 eyebrow text-ink-muted">{zoneHistory.stack.join(' · ')}</p>
          <a href={zoneHistory.href} target="_blank" rel="noopener noreferrer" class="inline-block mt-6 link-accent">
            {zoneHistory.linkText} &nearr;
          </a>
        </div>
      </section>

      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20 grid grid-cols-1 lg:grid-cols-[1fr_60%] gap-8 lg:gap-12 items-center">
        <div class="order-2 lg:order-1">
          <p class="eyebrow text-accent">{cinemetrics.eyebrow}</p>
          <h2 class="display text-ink mt-3 text-3xl sm:text-4xl">{cinemetrics.title}</h2>
          <p class="mt-5 text-ink-body">{cinemetrics.description}</p>
          <ul class="mt-5 space-y-1.5 text-sm text-ink-body">
            {cinemetrics.proofPoints.map(point => (
              <li class="flex gap-2.5"><span class="text-accent shrink-0" aria-hidden="true">&mdash;</span><span>{point}</span></li>
            ))}
          </ul>
          <p class="mt-5 eyebrow text-ink-muted">{cinemetrics.stack.join(' · ')}</p>
          <a href={cinemetrics.href} target="_blank" rel="noopener noreferrer" class="inline-block mt-6 link-accent">
            {cinemetrics.linkText} &nearr;
          </a>
        </div>
        <div class="order-1 lg:order-2">
          <RatingsConstellation />
        </div>
      </section>

      <section id="projects" class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
        <h2 class="eyebrow text-ink-muted border-b border-rule pb-3">Other Projects</h2>
        {projects.map(project => <ProjectRow {...project} />)}
        <p class="mt-10 text-ink-body">
          I also give casual <a href="/talks" class="link-accent">talks</a> to friends and colleagues on whatever I'm thinking about at the time.
        </p>
      </section>
    </main>
    <Footer />
  </div>
</Base>
