---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';

const posts = (await getCollection('blog'))
  .filter(post => post.data.published)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Page title="Blog" description="Writing about tech, economics, and data by David Hardage.">
  {posts.length === 0 ? (
    <p>No posts yet.</p>
  ) : (
    <div class="space-y-6 not-prose">
      {posts.map(post => (
        <a href={`/blog/${post.id}`} class="group block p-5 rounded-lg border border-rule bg-card hover:border-accent transition-colors">
          <h2 class="font-display text-lg font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
            {post.data.title}
          </h2>
          {post.data.subtitle && (
            <p class="mt-1 text-ink-muted text-sm">{post.data.subtitle}</p>
          )}
          <p class="mt-2 text-ink-body text-sm">{post.data.description}</p>
          <time class="eyebrow mt-3 block text-ink-muted" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </a>
      ))}
    </div>
  )}
</Page>
