---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';

// Filtered on `published`, same as the blog index and the RSS feed. Without it a
// draft still gets a reachable URL and a sitemap entry — hidden from the listing
// but published to the web, which is the opposite of what the flag promises.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => post.data.published)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Post
  title={post.data.title}
  subtitle={post.data.subtitle}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  description={post.data.description}
>
  <Content />
</Post>
