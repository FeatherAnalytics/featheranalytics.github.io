---
interface Props {
  label: string;
  min: number;
  max: number;
  step: number;
  value: number;
  /** Initial readout text. Replaced by the chart module on first input. */
  readout: string;
  /** Extra guidance, announced with the slider. */
  hint?: string;
}

const { label, min, max, step, value, readout, hint } = Astro.props;
const id = `rc-${Math.random().toString(36).slice(2, 9)}`;
---
<div class="chart-control">
  <label class="chart-control-label" for={id}>{label}</label>
  <input
    id={id}
    type="range"
    min={min}
    max={max}
    step={step}
    value={value}
    data-control
    aria-describedby={`${id}-out`}
  />
  <p class="chart-readout" id={`${id}-out`} data-readout aria-live="polite">{readout}</p>
  {hint && <p class="chart-caption">{hint}</p>}
</div>
