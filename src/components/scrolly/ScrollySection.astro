---
import '../../styles/scrolly.css';

interface Props {
  /**
   * Key into the chart registry in scrolly.ts, rendered as `data-chart`.
   *
   * Not named `chart`: this component also renders `<slot name="chart" />`
   * for its chart-figure child, and under Astro-in-MDX a prop and a named
   * slot sharing one name silently resolve to the slot — the prop never
   * reaches the template, `data-chart` renders empty, and every control on
   * the page goes inert with no error anywhere. If a future prop collides
   * with a slot name (`data`, `figure`, `label`) the same way, rename the
   * prop again rather than the slot — the slot name is the public call-site
   * convention (`slot="chart"` reads naturally at every usage).
   */
  chartKey: 'ppf' | 'window-quality' | 'budget' | 'jevons';
  /** Accessible name for the section landmark. */
  label: string;
}

const { chartKey, label } = Astro.props;
---
<scrolly-section class="scrolly not-prose" data-chart={chartKey} aria-label={label}>
  <div class="scrolly-grid">
    <div class="scrolly-panel">
      <slot name="chart" />
    </div>
    <div class="scrolly-steps">
      <slot />
    </div>
  </div>
</scrolly-section>

<script>
  import '../../scripts/scrolly';
</script>
