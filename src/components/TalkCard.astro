---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---
<a href={href} target="_blank" rel="noopener noreferrer" class="group block p-5 rounded-xl border border-border dark:border-dark-border hover:border-link dark:hover:border-dark-link bg-cloud dark:bg-dark-bg transition-colors">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="text-base font-semibold text-navy dark:text-dark-text group-hover:text-link dark:group-hover:text-dark-link transition-colors">
        {title}
      </h3>
      <p class="mt-1 text-text dark:text-dark-body text-sm">{description}</p>
    </div>
    <span class="shrink-0 text-text-secondary dark:text-dark-secondary text-sm mt-1">PDF</span>
  </div>
</a>
