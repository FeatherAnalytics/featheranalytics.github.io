---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---
<a href={href} target="_blank" rel="noopener noreferrer" class="group block p-5 rounded-lg border border-rule bg-card hover:border-accent transition-colors">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="font-display text-base font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
        {title}
      </h3>
      <p class="mt-1 text-ink-body text-sm">{description}</p>
    </div>
    <span class="eyebrow shrink-0 mt-1.5 px-1.5 py-0.5 rounded border border-rule bg-paper text-ink-muted">PDF</span>
  </div>
</a>
