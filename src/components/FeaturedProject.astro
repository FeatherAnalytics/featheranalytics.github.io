---
interface Props {
  title: string;
  tagline: string;
  description: string;
  highlights: string[];
  tags: string[];
  href: string;
}

const { title, tagline, description, highlights, tags, href } = Astro.props;
---
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group block p-6 sm:p-8 rounded-lg border border-rule bg-card hover:border-accent transition-colors"
>
  <p class="eyebrow text-accent">Featured Project</p>
  <h2 class="mt-2 font-display text-2xl sm:text-3xl font-bold tracking-tight text-ink group-hover:text-accent transition-colors">
    {title}
    <span class="inline-block ml-1 text-ink-muted text-lg">&nearr;</span>
  </h2>
  <p class="mt-1 text-ink-muted">{tagline}</p>
  <p class="mt-4 text-ink-body">{description}</p>
  <ul class="mt-4 space-y-1.5 text-sm text-ink-body">
    {highlights.map(item => (
      <li class="flex gap-2.5">
        <span class="text-accent shrink-0" aria-hidden="true">&mdash;</span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
  <div class="mt-5 pt-4 border-t border-rule flex flex-wrap items-center gap-1.5">
    {tags.map(tag => (
      <span class="eyebrow px-2 py-0.5 rounded-full border border-rule bg-paper text-ink-muted">
        {tag}
      </span>
    ))}
  </div>
</a>
