---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  links?: { label: string; href: string }[];
}

const { title, description, tags, href, links } = Astro.props;
---
<div class="p-6 rounded-xl border border-border dark:border-dark-border hover:border-link dark:hover:border-dark-link bg-cloud dark:bg-dark-bg transition-colors">
  <a href={href} target="_blank" rel="noopener noreferrer" class="group">
    <h3 class="text-lg font-semibold text-navy dark:text-dark-text group-hover:text-link dark:group-hover:text-dark-link transition-colors">
      {title}
      <span class="inline-block ml-1 text-text-secondary dark:text-dark-secondary text-sm">&nearr;</span>
    </h3>
  </a>
  <p class="mt-2 text-text dark:text-dark-body text-sm">{description}</p>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    {tags.map(tag => (
      <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-surface dark:bg-dark-code-bg text-text-secondary dark:text-dark-secondary">
        {tag}
      </span>
    ))}
  </div>
  {links && links.length > 0 && (
    <div class="mt-3 pt-3 border-t border-border dark:border-dark-border flex flex-wrap gap-3 text-sm">
      {links.map(link => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-link dark:text-dark-link hover:underline">
          {link.label}
        </a>
      ))}
    </div>
  )}
</div>
