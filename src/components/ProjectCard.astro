---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  links?: { label: string; href: string }[];
}

const { title, description, tags, href, links } = Astro.props;
---
<div class="p-6 rounded-lg border border-rule bg-card hover:border-accent transition-colors">
  <a href={href} target="_blank" rel="noopener noreferrer" class="group">
    <h3 class="font-display text-lg font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
      {title}
      <span class="inline-block ml-1 text-ink-muted text-sm">&nearr;</span>
    </h3>
  </a>
  <p class="mt-2 text-ink-body text-sm">{description}</p>
  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    {tags.map(tag => (
      <span class="eyebrow px-2 py-0.5 rounded-full border border-rule bg-paper text-ink-muted">
        {tag}
      </span>
    ))}
  </div>
  {links && links.length > 0 && (
    <div class="mt-3 pt-3 border-t border-rule flex flex-wrap gap-3 text-sm">
      {links.map(link => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover underline underline-offset-2">
          {link.label}
        </a>
      ))}
    </div>
  )}
</div>
